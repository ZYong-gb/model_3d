FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

# ========== 支持构建时传入代理 ==========
ARG HTTP_PROXY
ARG HTTPS_PROXY

# 设置环境变量（有值就设置，没值就空）
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}

# 只有在有值时才设置小写版本（避免空值污染环境）
RUN if [ -n "$HTTP_PROXY" ]; then export http_proxy=$HTTP_PROXY; fi && \
    if [ -n "$HTTPS_PROXY" ]; then export https_proxy=$HTTPS_PROXY; fi

# 设置非交互式安装
ENV DEBIAN_FRONTEND=noninteractive

# 安装系统依赖（✅ 在系统层安装）
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    unzip \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    python3-pip \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libsparsehash-dev \
    libopenblas-dev \
    libeigen3-dev \
    # 新增依赖,升级GCC到10
    gcc-10 \
    g++-10 \
    && rm -rf /var/lib/apt/lists/*

# 配置 gcc/g++ 默认版本为 10 ✅
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-10 100 --slave /usr/bin/g++ g++ /usr/bin/g++-10


# 安装 Miniconda 并接受 ToS
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/conda && \
    rm /tmp/miniconda.sh && \
    # ✅ 关键：接受服务条款
    /opt/conda/bin/conda init bash && \
    . /opt/conda/etc/profile.d/conda.sh && \
    conda activate base && \
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r && \
    # 继续更新 conda 和清理
    /opt/conda/bin/conda update -n base -c defaults conda -y && \
    /opt/conda/bin/conda clean -ya


# 设置 Conda 路径（仅 base）
ENV PATH /opt/conda/bin:$PATH

RUN conda create -n myenv python=3.11 -y

WORKDIR /model/TurboReg

# 复制项目文件
COPY . /model/TurboReg

RUN conda run -n myenv pip install torch==2.3.0 torchvision==0.18.0 torchaudio==2.3.0 --index-url https://download.pytorch.org/whl/cu121

RUN conda run -n myenv pip install open3d==0.19.0 tyro==0.9.35

RUN cd /model/TurboReg/bindings && conda run -n myenv pip install . --no-build-isolation
# 禁用构建隔离：--no-build-isolation 参数,告诉 pip：不要创建干净的构建环境，直接使用当前 Python 环境中的已安装包。

# 入口点：运行 test_depth.py
ENTRYPOINT ["conda", "run", "-n", "myenv"]
# 默认参数
CMD ["python", "run_my_ply_file.py"]

